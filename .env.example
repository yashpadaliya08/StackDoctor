# ==============================================================================
# 🩺 StackDoctor - Environment Configuration & Secrets Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Populate the secrets and endpoints according to your local / deployment setup.
# 3. NEVER commit your actual .env file with live credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Binding
# ------------------------------------------------------------------------------
STACKDOCTOR_HOST=127.0.0.1
STACKDOCTOR_PORT=8000
MAX_UPLOAD_SIZE_BYTES=104857600
DEFAULT_DOMAIN_SUFFIX=studentapp.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Master Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Master API Key for privileged management actions (terminal exec, stop, delete)
# Leave empty in local development and CI testing to permit loopback access, or set a secure token for production.
STACKDOCTOR_API_KEY=

# Secret key required to push audit entries to /api/security/audit-logs/record
SD_AUDIT_API_KEY=stackdoctor-internal-key

# Optional JWT secret for session token signing
JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. Android ARM Edge Compute Runtime (Termux / ADB)
# ------------------------------------------------------------------------------
# IP address or hostname of the spare phone (127.0.0.1 when using 'adb forward tcp:8022 tcp:8022')
PHONE_HOST=127.0.0.1
PHONE_PORT=8022
PHONE_USER=termux
PHONE_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Networking & Cloudflare Zero-Trust Tunnels
# ------------------------------------------------------------------------------
# Automatically spawn cloudflared tunnel daemon for public HTTPS (*.trycloudflare.com)
CLOUDFLARE_TUNNEL_ENABLED=true

# ------------------------------------------------------------------------------
# 5. 24/7 Background Self-Healing Watchdog
# ------------------------------------------------------------------------------
# Frequency in seconds for health heartbeat inspections across active deployments
WATCHDOG_INTERVAL=25
